# ==========================================
# Aniqus Enterprise Knowledge Engine .gitignore
# ==========================================

# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend Dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend Build Outputs
dist/
frontend/dist/
build/
.next/

# Runtime Data, Databases & Vector Stores
data/
*.db
*.sqlite
*.sqlite3

# Environment Variables & Secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env.local

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Assignment / Brief PDFs (Keep private)
11_Full-Stack_AI_Portfolio_Projects.pdf

# Logs
logs/
*.log

