# ========================================================
# Aniqus Enterprise Grounded Knowledge Engine
# Environment Configuration Template
# ========================================================

# [1] LLM Provider Configuration (Optional)
# Aniqus runs out-of-the-box with a built-in local grounded synthesizer
# that streams citations offline with zero API keys or external costs.
# To connect high-capacity cloud LLMs, uncomment and provide a key below:

# OpenAI (default: gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (default: gemini-1.5-flash)
# GEMINI_API_KEY=your_gemini_api_key_here

# [2] Server Configuration
HOST=0.0.0.0
PORT=8008

# [3] Retrieval & Reranker Settings
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# RERANKER_MODEL_NAME=ms-marco-TinyBERT-L-2-v2
# HYBRID_SEARCH_TOP_K=15
# RERANK_TOP_K=4
# SEMANTIC_CACHE_THRESHOLD=0.94

